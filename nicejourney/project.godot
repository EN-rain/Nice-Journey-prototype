; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nice Journey"
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/art/ui/application/application_icon_tower_sigil_v02.png"

[autoload]

InputDefaults="*res://src/core/input/input_defaults.gd"
AudioService="*res://src/audio/audio_service.gd"
AccessibilitySettings="*res://src/core/accessibility/accessibility_settings.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Nice Journey"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
