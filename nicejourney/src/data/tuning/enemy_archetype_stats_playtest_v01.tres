"duelist": SubResource("Stats_duelist"),
"bruiser": SubResource("Stats_bruiser"),
"defender": SubResource("Stats_defender"),
"skirmisher": SubResource("Stats_skirmisher"),
"assassin": SubResource("Stats_assassin"),
