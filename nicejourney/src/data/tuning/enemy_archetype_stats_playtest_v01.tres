[gd_resource type="Resource" script_class="EnemyArchetypePlaytestStatsCatalog" load_steps=15 format=3]

[ext_resource type="Script" path="res://src/data/tuning/enemy_archetype_playtest_stats.gd" id="1_stats"]
[ext_resource type="Script" path="res://src/data/tuning/enemy_archetype_playtest_stats_catalog.gd" id="2_catalog"]

